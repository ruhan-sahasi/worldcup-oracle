# Copy to `.env` and fill in to enable the live data feed. All values are optional.

# Free API key from https://www.football-data.org/client/register
# When set, the server/CLI uses the LIVE 2026 World Cup feed; otherwise it runs the
# deterministic simulation (no key needed).
FOOTBALL_DATA_API_KEY=

# Address the server listens on.
ORACLE_ADDR=0.0.0.0:8080

# Log filter (e.g. info, debug, oracle_engine=debug).
RUST_LOG=info
